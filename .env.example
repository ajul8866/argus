# Argus runtime configuration. Copy to .env for Docker Compose or export locally.

# Network
ARGUS_PORT=8787
ARGUS_HOST=127.0.0.1

# Data and allowed repository roots (colon-separated).
ARGUS_DATA_DIR=./data
ARGUS_ALLOWED_ROOTS=./data/repos:/srv/authorized-repos

# First-run administrator. If ARGUS_ADMIN_PASSWORD is unset, Argus generates a
# password and writes it to $ARGUS_DATA_DIR/bootstrap-admin.txt (mode 0600).
ARGUS_ADMIN_EMAIL=admin@argus.local
# Leave unset to generate a unique password, or set your own before first start.

# Sessions and cookies
ARGUS_SESSION_TTL_HOURS=12
ARGUS_SECURE_COOKIES=0

# Execution
ARGUS_MAX_AGENTS=4
# auto | bwrap | none. Use bwrap on a host that supports user namespaces.
# Docker deployments commonly use none and rely on the container + read-only
# workspace copies; document that choice explicitly.
ARGUS_SANDBOX=auto

# Harness binaries
ARGUS_PI_BIN=pi
ARGUS_CLAUDE_BIN=claude
ARGUS_CHROME_BIN=google-chrome

# Encrypt provider credentials stored in SQLite. If omitted, Argus generates
# $ARGUS_DATA_DIR/master.key with mode 0600.
# ARGUS_MASTER_KEY=

# Logging
ARGUS_LOG_LEVEL=info
