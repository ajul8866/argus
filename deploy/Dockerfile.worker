# The worker container: an agent runtime with no route to the target except
# the broker. It is read-only, unprivileged, and holds no target credentials.
FROM oven/bun:1.3.14-debian

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
     ca-certificates curl git jq python3 python3-requests nodejs npm \
  && rm -rf /var/lib/apt/lists/*

ARG PI_VERSION=1.3.0
ARG CLAUDE_CODE_VERSION=2.1.310
RUN npm install -g "@earendil-works/pi-coding-agent@${PI_VERSION}" "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
  && npm cache clean --force

WORKDIR /app
COPY package.json bun.lock tsconfig.json ./
RUN bun install --frozen-lockfile

COPY src ./src
COPY scripts/mcp-adapter.ts ./scripts/mcp-adapter.ts

# The repository snapshot is mounted read-only at /repo, and the only writable
# paths are the scratch mounts provided at run time.
ENV ARGUS_WORKER_SCRATCH=/workspace \
    ARGUS_REPO_ROOT=/repo \
    HOME=/tmp

USER 1000:1000
CMD ["sleep", "infinity"]
